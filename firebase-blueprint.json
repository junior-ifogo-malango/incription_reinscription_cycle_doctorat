{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil utilisateur authentifié via Google Firebase Auth avec rôle applicatif USMBA.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Identifiant unique Firebase Auth (UID).",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Adresse e-mail Google vérifiée de l'utilisateur.",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "Nom complet affiché depuis le compte Google.",
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "description": "URL de la photo de profil Google.",
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "description": "Rôle applicatif attribué à l'utilisateur.",
          "enum": ["candidat", "enseignant", "directeur_ced", "doctorant", "agent", "admin"]
        },
        "authProvider": {
          "type": "string",
          "description": "Fournisseur d'authentification utilisé.",
          "enum": ["google"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Horodatage serveur de création du profil."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Horodatage serveur de dernière mise à jour."
        }
      },
      "required": ["uid", "email", "displayName", "role", "authProvider", "createdAt", "updatedAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Marqueur d'habilitation administrateur pour le contrôle d'accès basé sur les rôles.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "UID de l'administrateur.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "E-mail de l'administrateur.",
          "minLength": 3,
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Horodatage serveur d'attribution."
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "CandidatureDossier": {
      "title": "CandidatureDossier",
      "description": "Candidature déposée et métadonnées du dossier candidat synchronisées sur Firestore (sans fichiers base64).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifiant unique du candidat.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "UID Firebase Auth du compte ayant synchronisé la candidature.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nom": {
          "type": "string",
          "description": "Nom complet du candidat.",
          "maxLength": 160
        },
        "nomFamille": {
          "type": "string",
          "description": "Nom de famille du candidat.",
          "maxLength": 100
        },
        "prenom": {
          "type": "string",
          "description": "Prénom du candidat.",
          "maxLength": 100
        },
        "cne": {
          "type": "string",
          "description": "Code Massar / CNE du candidat.",
          "maxLength": 32
        },
        "cin": {
          "type": "string",
          "description": "Numéro de CIN du candidat.",
          "maxLength": 32
        },
        "email": {
          "type": "string",
          "description": "Adresse e-mail du candidat.",
          "maxLength": 254
        },
        "tel": {
          "type": "string",
          "description": "Numéro de téléphone du candidat.",
          "maxLength": 40
        },
        "candidatures": {
          "type": "array",
          "description": "Liste des identifiants de sujets sélectionnés (max 10)."
        },
        "candidaturesStatuts": {
          "type": "object",
          "description": "Statuts par identifiant de sujet."
        },
        "statutDossier": {
          "type": "string",
          "description": "Statut synthétique de la candidature déposée.",
          "enum": ["brouillon", "deposee", "retenue", "a_corriger"]
        },
        "piecesStatuts": {
          "type": "object",
          "description": "Statut de chaque pièce justificative (CIN, DIPLOME, RELEVES)."
        },
        "envoyeLe": {
          "type": "string",
          "description": "Date ISO d'envoi du dossier.",
          "maxLength": 64
        },
        "syncedByEmail": {
          "type": "string",
          "description": "Adresse e-mail du compte Google ayant effectué la synchronisation.",
          "minLength": 3,
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Horodatage serveur de création."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Horodatage serveur de dernière mise à jour."
        }
      },
      "required": ["id", "ownerUid", "nom", "email", "candidatures", "statutDossier", "syncedByEmail", "createdAt", "updatedAt"]
    },
    "ProcesVerbal": {
      "title": "ProcesVerbal",
      "description": "Procès-verbal de commission généré, signé (3 signatures papier) et déposé vers la Structure.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifiant unique du PV.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "UID Firebase Auth du directeur ayant synchronisé le PV.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "directeurId": {
          "type": "string",
          "description": "Identifiant métier du directeur de thèse.",
          "minLength": 1,
          "maxLength": 128
        },
        "structure": {
          "type": "string",
          "description": "Structure de recherche rattachée.",
          "maxLength": 200
        },
        "date": {
          "type": "string",
          "description": "Date de la séance (AAAA-MM-JJ).",
          "minLength": 1,
          "maxLength": 32
        },
        "code": {
          "type": "string",
          "description": "Code de référence du PV.",
          "maxLength": 64
        },
        "statut": {
          "type": "string",
          "description": "État du PV dans le circuit de validation.",
          "enum": ["a_signer", "signe", "envoye", "publie", "original_recu", "approuve"]
        },
        "scanStatut": {
          "type": "string",
          "description": "Statut de vérification du scan.",
          "enum": ["en_attente", "valide", "refuse"]
        },
        "scanDeposeLe": {
          "type": "string",
          "description": "Horodatage ISO du dépôt du scan signé.",
          "maxLength": 64
        },
        "envoyeLe": {
          "type": "string",
          "description": "Horodatage ISO de transmission à la Structure.",
          "maxLength": 64
        },
        "envoyePar": {
          "type": "string",
          "description": "Nom du directeur ayant transmis le PV.",
          "maxLength": 160
        },
        "publieLe": {
          "type": "string",
          "description": "Horodatage ISO de publication par la Structure.",
          "maxLength": 64
        },
        "signaturesCount": {
          "type": "number",
          "description": "Nombre de signatures de la commission validées (0 à 3)."
        },
        "membres": {
          "type": "array",
          "description": "Liste des membres de la commission (max 5)."
        },
        "resultats": {
          "type": "array",
          "description": "Résultats figés des candidats évalués sur le PV (max 50)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Horodatage serveur de création."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Horodatage serveur de dernière mise à jour."
        }
      },
      "required": ["id", "ownerUid", "directeurId", "structure", "date", "statut", "signaturesCount", "membres", "resultats", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Profils utilisateurs privés (PII isolée par propriétaire et administrateur)."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Registre des comptes administrateurs autorisés."
    },
    "/candidatures_deposees/{candidatId}": {
      "schema": { "$ref": "#/entities/CandidatureDossier" },
      "description": "Candidatures déposées et dossiers candidats synchronisés sur Firestore."
    },
    "/pvs/{pvId}": {
      "schema": { "$ref": "#/entities/ProcesVerbal" },
      "description": "Procès-verbaux de commission signés et transmis à la Structure."
    }
  }
}
